              "profile_signal": "evaluation_noise",
              "amplitude": 0.05
            },
            "clamp": {
              "min": 0,
              "max": 1
            }
          }
        },
        "recovery_dispatch": {
          "mode": "rank_then_select",
          "description": "Escolhe o melhor reposicionamento quando o caminhao termina sem carga imediata na cidade atual.",
          "ranking_formula": {
            "type": "profile_weighted_score",
            "base": 0.02,
            "terms": [
              {
                "profile_signal": "weight_reposition_opportunity",
                "runtime_signal": "destination_opportunity_norm",
                "weight": 0.28
              },
              {
                "profile_signal": "weight_distance_efficiency",
                "runtime_signal": "distance_efficiency_norm",
                "weight": 0.24
              },
              {
                "profile_signal": "emergency_return_bias",
                "runtime_signal": "return_home_norm",
                "weight": 0.18
              },
              {
                "profile_signal": "recovery_quality",
                "runtime_signal": "target_flow_value_norm",
                "weight": 0.14
              },
              {
                "profile_signal": "planning_horizon_turns",
                "runtime_signal": "destination_followup_norm",
                "weight": 0.08
              },
              {
                "profile_signal": "consistency",
                "runtime_signal": "route_stability_norm",
                "weight": 0.05
              },
              {
                "profile_signal": "adaptation_speed",
                "runtime_signal": "frontier_bonus_norm",
                "weight": 0.05
              },
              {
